{
    "name": "maira",
    "version": "1.0.0",
    "description": "Mesa de Arena Interactiva de Realidad Aumentada",
    "main": "indexP.js",
    "scripts": {
        "start": "python3 app.py",
        "build": "./install_deps_render.sh",
        "postinstall": "npm config set legacy-peer-deps true && echo 'NPM configurado con legacy-peer-deps' && ls node_modules/@fortawesome/ 2>/dev/null || echo 'Instalación en progreso...' && ls node_modules/milsymbol/ 2>/dev/null || echo 'Dependencias críticas verificándose...'",
        "start-py": "python3 server/server.py",
        "start-js": "node server/node.js",
        "start-gestos": "python3 /Users/mac/Documents/GitHub/MAIRA_git/Server/detectorGestos.py",
        "dev": "concurrently \"npm run start-py\" \"npm run start-js\" \"npm start\"",
        "install-gesture-deps": "python3 server/install_deps.py",
        "start-py-https": "python3 server/serverhttps.py",
        "dev-https": "concurrently \"npm run start-py-https\" \"npm run start-js\"",
        "build:production": "npm run optimize:assets && npm run prepare:client",
        "optimize:assets": "echo 'Optimizing assets for production...'",
        "prepare:client": "echo 'Preparing client files for static hosting...'",
        "test": "jest",
        "test:unit": "jest tests/unit/",
        "test:integration": "jest tests/integration/",
        "test:e2e": "jest tests/e2e/",
        "test:complete": "jest tests/e2e/test_complete_system.js",
        "test:planeamiento": "jest tests/e2e/test_planeamiento_complete.js",
        "test:gb": "jest tests/e2e/test_inicioGB_complete.js",
        "test:simple": "jest tests/e2e/test_system_simplified.js",
        "test:planeamiento-simple": "jest tests/e2e/test_planeamiento_simplified.js",
        "test:gb-simple": "jest tests/e2e/test_gb_simplified.js",
        "test:all-simple": "jest tests/e2e/test_system_simplified.js tests/e2e/test_planeamiento_simplified.js tests/e2e/test_gb_simplified.js",
        "test:python": "python3 tests/unit/test_socket_backend.py",
        "test:all": "./run_tests.sh"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "5.15.4",
        "@gltf-transform/cli": "^4.2.1",
        "@mapbox/corslite": "^0.0.7",
        "@raruto/leaflet-elevation": "^2.5.1",
        "@socket.io/component-emitter": "^3.1.2",
        "bootstrap": "^4.6.2",
        "chart.js": "^4.5.0",
        "cors": "^2.8.5",
        "d3": "^7.9.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "file-saver": "^2.0.5",
        "geotiff": "^2.1.3",
        "glob": "^11.0.0",
        "html2canvas": "^1.4.1",
        "http": "^0.0.1-security",
        "http-server": "^14.1.1",
        "jquery": "^3.7.1",
        "jspdf": "^2.5.1",
        "jsplumb": "^2.15.6",
        "leaflet-bing-layer": "^3.3.1",
        "leaflet-control-geocoder": "^2.4.0",
        "leaflet-draw": "^1.0.4",
        "leaflet-easybutton": "^2.4.0",
        "leaflet-fullscreen": "^1.0.2",
        "leaflet-geometryutil": "^0.9.3",
        "leaflet-geosearch": "^3.11.1",
        "leaflet-measure": "^3.1.0",
        "leaflet-polylinedecorator": "^1.6.0",
        "leaflet-providers": "^1.13.0",
        "leaflet-search": "^3.0.11",
        "leaflet-sidebar-v2": "^3.2.3",
        "leaflet-utfgrid": "^0.3.0",
        "leaflet.gridlayer.googlemutant": "^0.13.5",
        "leaflet.markercluster": "^1.5.3",
        "mgrs": "^1.0.0",
        "milsymbol": "^2.2.0",
        "mkdirp": "^3.0.1",
        "mysql2": "^3.11.3",
        "pako": "^2.1.0",
        "proj4": "^2.19.10",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hexgrid": "^2.0.1",
        "rimraf": "^6.0.1",
        "socket.io": "^4.8.0",
        "socket.io-client": "^4.8.1",
        "three": "^0.160.1",
        "three-orbitcontrols": "^2.110.3"
    },
    "devDependencies": {
        "@babel/core": "^7.26.9",
        "@babel/preset-env": "^7.26.9",
        "babel-jest": "^29.7.0",
        "concurrently": "^6.5.1",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "leaflet": "^1.9.4",
        "prettier": "^2.8.8"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "setupFilesAfterEnv": [
            "<rootDir>/tests/setup.js"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/Client/js/$1"
        },
        "transform": {
            "^.+\\.js$": "babel-jest"
        },
        "testMatch": [
            "<rootDir>/tests/**/*.js"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "/tests/setup.js"
        ],
        "collectCoverageFrom": [
            "Client/js/**/*.js",
            "!Client/js/Libs/**",
            "!**/node_modules/**"
        ],
        "verbose": true
    },
    "babel": {
        "presets": [
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                }
            ]
        ]
    },
    "keywords": [],
    "author": "EHR051",
    "license": "ISC"
}
